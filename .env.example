# Copy this file to ".env" (same folder) and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=your_key_here

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-haiku-5-5
# EMBEDDER=minilm        # or "hashing" for offline/no-download mode
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K=4
